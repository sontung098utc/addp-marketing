# ====================================================================
# OPENAI AGENT BRIDGE - CẤU HÌNH MẪU (KHÔNG CHỨA BÍ MẬT)
# Sao chép tệp này thành .env.local và điền API Key của bạn
# Tuyệt đối không commit .env.local lên hệ thống quản lý mã nguồn (Git)
# ====================================================================

# Khóa API của OpenAI (Bắt đầu bằng sk-proj-... hoặc sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# (Tùy chọn) Mô hình mặc định (gpt-4o, gpt-4o-mini)
OPENAI_MODEL=gpt-4o

# (Tùy chọn) Hạn mức token tối đa cho mỗi phiên chạy thử (mặc định: 50000)
MAX_TOKEN_BUDGET=50000
