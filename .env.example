# ====================================================================
# ADDP COMMERCE INTELLIGENCE - ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL PRODUCTION VALUES TO VERSION CONTROL
# Copy this file to .env and configure values on the production server.
# ====================================================================

# Runtime Environment (production / development)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://marketing.addp.vn

# Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=addp_marketing
DB_USER=addp_marketing
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# Administrative Authentication
# Recommended: Set ADMIN_PASSWORD_HASH using password_hash('YOUR_PASS', PASSWORD_BCRYPT)
ADMIN_USERNAME=addp_admin
ADMIN_PASSWORD_HASH=
# Transitional fallback for plain password verification if hash is not set
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# Dedicated API Auth Signing Key (64-character hex string recommended)
# Generate using: php -r "echo bin2hex(random_bytes(32));"
AUTH_SIGNING_KEY=YOUR_64_CHAR_HEX_SIGNING_KEY_HERE

# TikTok Shop Partner Credentials (from Partner Center)
TIKTOK_APP_KEY=YOUR_TIKTOK_APP_KEY_HERE
TIKTOK_APP_SECRET=YOUR_TIKTOK_APP_SECRET_HERE
TIKTOK_REDIRECT_URI=https://marketing.addp.vn/api/oauth.php

# TikTok Ads Manager Credentials (from TikTok for Business Developer)
TIKTOK_ADS_APP_ID=YOUR_TIKTOK_ADS_APP_ID_HERE
TIKTOK_ADS_SECRET=YOUR_TIKTOK_ADS_SECRET_HERE
TIKTOK_ADS_REDIRECT_URI=https://marketing.addp.vn/api/oauth_ads.php

# Google Gemini API Key (Optional)
GEMINI_API_KEY=
